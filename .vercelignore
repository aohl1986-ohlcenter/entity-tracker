# Lokale Ops-/Wartungs-Skripte (werden mit tsx direkt ausgeführt und von
# app/ bzw. lib/ nirgends importiert). Sie im Deployment mitzuschicken bringt
# keinen Nutzen, zieht sie aber in `next build` --> ein Typfehler in einem
# reinen Hilfsskript hat am 04.08.2026 den Prod-Deploy blockiert.
scripts/

# Der MCP-Server ist wie scripts/ ein reines Ops-Werkzeug: er läuft lokal
# über tsx und wird von app/ nirgends importiert.
mcp/
